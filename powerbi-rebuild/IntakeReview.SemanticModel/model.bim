          },
          {
            "name": "Date Issue",
            "dataType": "int64",
            "lineageTag": "3fa04ace-65fd-4785-a25f-8c5e63d5a472",
            "sourceColumn": "Date Issue",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "a90e8324-f693-4b54-b597-020994d51d37",
        "measures": [
          {
            "name": "Cases",
            "expression": "COUNTROWS('Cases')",
            "formatString": "#,0",
            "lineageTag": "393281ea-c36e-4c73-908b-9585eaed580f"
          },
          {
            "name": "Valid Intervals",
            "expression": "SUM('Cases'[Valid Duration])",
            "formatString": "#,0",
            "lineageTag": "b691ae7d-e703-446c-ac0d-70946028ce79"
          },
          {
            "name": "Review Cases",
            "expression": "SUM('Cases'[Needs Review])",
            "formatString": "#,0",
            "lineageTag": "000cf8a0-4393-4fce-987e-d1e5c764716e"
          },
          {
            "name": "Date Issues",
            "expression": "SUM('Cases'[Date Issue])",
            "formatString": "#,0",
            "lineageTag": "9da8c907-4d63-4a14-9496-3be02e57bc17"
          },
          {
            "name": "Over Seven Days",
            "expression": "SUM('Cases'[Over 7 Days])",
            "formatString": "#,0",
            "lineageTag": "56c97b76-4195-4414-a475-f0863e5a7458"
          },
          {
            "name": "Review Share",
            "expression": "DIVIDE([Review Cases],[Cases])",
            "formatString": "0.0%",
            "lineageTag": "51130282-9f4b-4a50-9613-8e64f85bce0f"
          },
          {
            "name": "Known Timely",
            "expression": "CALCULATE([Cases],'Cases'[Timely flag] IN {\"Yes\",\"No\"})",
            "formatString": "#,0",
            "lineageTag": "f15392dd-8451-408f-904f-3c4b12ac7599"
          },
          {
            "name": "Timely Rate",
            "expression": "DIVIDE(CALCULATE([Cases],'Cases'[Timely flag]=\"Yes\"),[Known Timely])",
            "formatString": "0.0%",
            "lineageTag": "260346b6-148d-4db3-be7d-61c9612ac7a3"
          },
          {
            "name": "P90 Routing Days",
            "expression": "VAR N = [Valid Intervals] VAR K = ROUNDUP(N * 0.9,0) RETURN IF(N > 0, MAXX(TOPN(K,FILTER('Cases','Cases'[Valid Duration]=1),'Cases'[Routing Days],ASC),'Cases'[Routing Days]))",
            "formatString": "0",
            "lineageTag": "ac34be40-585c-4a84-82fe-75976a79ed57"
          },
          {
            "name": "Median Routing Days",
            "expression": "MEDIANX(FILTER('Cases','Cases'[Valid Duration]=1),'Cases'[Routing Days])",
            "formatString": "0.0",
            "lineageTag": "e470bc3f-e5b8-4db0-b84c-451fd32ddaff"
          }
        ],
        "partitions": [
          {
            "name": "Cases",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/Cases.csv\"), [Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"Complaint ID\", type text}, {\"Received\", type date}, {\"Year\", type text}, {\"Month\", type text}, {\"Channel\", type text}, {\"Product\", type text}, {\"Timely flag\", type text}, {\"Routing Days\", Int64.Type}, {\"Valid Duration\", Int64.Type}, {\"Over 7 Days\", Int64.Type}, {\"Needs Review\", Int64.Type}, {\"Date Issue\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
